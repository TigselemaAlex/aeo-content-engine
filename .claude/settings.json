{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/check-reglas.mjs", "pre"],
            "timeout": 15,
            "statusMessage": "Revisando si es una migracion ya aplicada"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/check-reglas.mjs", "post"],
            "timeout": 15,
            "statusMessage": "Revisando reglas de arquitectura"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/check-on-stop.mjs"],
            "timeout": 600,
            "statusMessage": "Comprobando el worker antes de terminar"
          }
        ]
      }
    ]
  }
}
